\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Local projection dynamic event-study path: estimated premium at horizon $h$ days after the duty hike ($\hat  {\beta }_h$), with 95\% confidence bands. The premium jumps to Rs.\,10,136 (84.5\%) on Day 0, peaks at Rs.\,10,411 (86.8\%) on Day 1, and holds a broad plateau through Day 14 (77.5\%). The 95\% CI excludes zero throughout $h = 0$--$16$, the reliable window in which at least 15 effective post-hike observations contribute ($31 - h$ at each horizon). Estimates beyond $h = 16$ rest on 14 or fewer effective post-hike observations and should be treated as indicative only.\relax }}{12}{figure.2}\protected@file@percent }
\newlabel{fig:lp}{{2}{12}{Local projection dynamic event-study path: estimated premium at horizon $h$ days after the duty hike ($\hat {\beta }_h$), with 95\% confidence bands. The premium jumps to Rs.\,10,136 (84.5\%) on Day 0, peaks at Rs.\,10,411 (86.8\%) on Day 1, and holds a broad plateau through Day 14 (77.5\%). The 95\% CI excludes zero throughout $h = 0$--$16$, the reliable window in which at least 15 effective post-hike observations contribute ($31 - h$ at each horizon). Estimates beyond $h = 16$ rest on 14 or fewer effective post-hike observations and should be treated as indicative only.\relax }{figure.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}Robustness}{13}{section.7}\protected@file@percent }
\newlabel{sec:robust}{{7}{13}{Robustness}{section.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Placebo test: ITS $\hat  {\beta }_1$ estimates at three fake treatment dates (Nov 1, 2025; Jan 15, 2026; Mar 1, 2026) alongside the true May 13, 2026 estimate. Nov 1, 2025 is non-significant ($p = 0.40$). Jan 15 and Mar 1, 2026 are significant at 5\% but both are contaminated -- their post-fake windows include actual post-hike premium data. Even the largest contaminated placebo (Rs.\,3,399) is only 33\% of the true $\hat  {\beta }_1 = $ Rs.\,10,136. The true May 13 estimate is a clear outlier by magnitude and significance.\relax }}{13}{figure.3}\protected@file@percent }
\newlabel{fig:placebo}{{3}{13}{Placebo test: ITS $\hat {\beta }_1$ estimates at three fake treatment dates (Nov 1, 2025; Jan 15, 2026; Mar 1, 2026) alongside the true May 13, 2026 estimate. Nov 1, 2025 is non-significant ($p = 0.40$). Jan 15 and Mar 1, 2026 are significant at 5\% but both are contaminated -- their post-fake windows include actual post-hike premium data. Even the largest contaminated placebo (Rs.\,3,399) is only 33\% of the true $\hat {\beta }_1 = $ Rs.\,10,136. The true May 13 estimate is a clear outlier by magnitude and significance.\relax }{figure.3}{}}
